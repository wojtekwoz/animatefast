{
  "name": "animatefast",
  "version": "0.1.2",
  "private": true,
  "description": "animatefast Lite: 12 GSAP text and element animations an AI coding agent applies with one data-motion attribute, plus lint and render checks.",
  "scripts": {
    "build": "npx -y esbuild@0.28.2 dist/animatefast-lite.js --minify --legal-comments=inline --target=es2018 --outfile=dist/animatefast-lite.min.js",
    "lint": "node scripts/lint.cjs",
    "test": "node --test tests/*.test.cjs",
    "verify": "node scripts/verify.cjs"
  },
  "dependencies": {
    "puppeteer-core": "^25.18.1"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
