{
 "version": "0.1.0",
 "attributes": {
  "data-motion": "effect slug",
  "data-motion-trigger": "scroll (default) | load | hover (implicit for button and magnetic effects)",
  "data-motion-delay": "seconds",
  "data-motion-duration": "seconds, overrides the effect default",
  "data-motion-stagger": "seconds between items (text: between chars/words/lines, elements: between same-effect siblings)",
  "data-motion-start": "ScrollTrigger start, default top 80% (runtime clamps it so footer elements still fire)",
  "data-motion-from": "image-wipe: center|left|right|top|bottom; magnetic: text"
 },
 "effects": [
  {
   "slug": "char-fade-down",
   "family": "text",
   "tier": "lite",
   "trigger": "scroll",
   "targets": "headings and short text (under ~120 characters)",
   "legacy": "txt.1",
   "plugins": [
    "ScrollTrigger",
    "SplitText"
   ],
   "defaults": "split chars; from {opacity 0, y -20}; 0.4s; stagger 0.03; power2.out",
   "perf": "low",
   "reduced_motion": "show-final",
   "markup": "<h1 data-motion=\"char-fade-down\">Build faster with motion</h1>",
   "options": "duration 0.3-0.8, stagger 0.02-0.06, trigger load for above-the-fold headlines"
  },
  {
   "slug": "char-flip-y",
